# ocserv NAT / 转发规则持久化单元
# deploy: install -m 644 ocserv-nat.service.example /etc/systemd/system/ocserv-nat.service
#         把下面两处 @VPNNET@ 改成 ocserv.conf 里的 ipv4-network，eth0 改成出口网卡
#         systemctl daemon-reload && systemctl enable --now ocserv-nat
[Unit]
Description=ocserv NAT/forwarding rules
After=network-online.target
Before=ocserv.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c 'sysctl -w net.ipv4.ip_forward=1; \
 iptables -t nat -C POSTROUTING -s @VPNNET@ -o @OUTIF@ -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s @VPNNET@ -o @OUTIF@ -j MASQUERADE; \
 iptables -C FORWARD -s @VPNNET@ -j ACCEPT 2>/dev/null || iptables -A FORWARD -s @VPNNET@ -j ACCEPT; \
 iptables -C FORWARD -d @VPNNET@ -j ACCEPT 2>/dev/null || iptables -A FORWARD -d @VPNNET@ -j ACCEPT'
ExecStop=/bin/bash -c 'iptables -t nat -D POSTROUTING -s @VPNNET@ -o @OUTIF@ -j MASQUERADE 2>/dev/null; \
 iptables -D FORWARD -s @VPNNET@ -j ACCEPT 2>/dev/null; \
 iptables -D FORWARD -d @VPNNET@ -j ACCEPT 2>/dev/null; true'

[Install]
WantedBy=multi-user.target
